// AUTOFLOW 2.0 — Cloudflare Workers (API + front estático no mesmo domínio). Config na RAIZ do monorepo (Workers Builds roda `npx wrangler deploy` aqui). Ver docs/CLOUDFLARE.md.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "autoflow",
  "main": "apps/api/src/worker.ts",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  // Front (apps/web/dist). API em /api/*; SSR público, arquivos assinados e webhooks atendidos pelo Worker na raiz.
  "assets": {
    "directory": "apps/web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/o/*", "/c/*", "/m/*", "/files/*", "/webhooks/*", "/robots.txt", "/sitemap*", "/health", "/ready", "/metrics"]
  },
  // Postgres externo (Neon/Supabase/RDS…) via Hyperdrive. Crie com: wrangler hyperdrive create autoflow-db --connection-string=...
  "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "4b3fe1c72c4f46d49598ce7e18ce96a3", "localConnectionString": "postgres://app_rw:app_rw_dev@127.0.0.1:5432/autoflow_dev" }],
  // Arquivos: por padrão no Postgres (STORAGE_BACKEND=postgres, sem custo/cartão; limite = espaço do banco).
  // Para usar R2 (recomendado em produção): ative o R2, crie o bucket PRIVADO e descomente a linha abaixo (o binding FILES tem prioridade).
  // "r2_buckets": [{ "binding": "FILES", "bucket_name": "autoflow-files" }],
  "triggers": { "crons": ["* * * * *", "*/5 * * * *", "0 * * * *"] },
  "observability": { "enabled": true },
  "vars": {
    "NODE_ENV": "production",
    "STORAGE_BACKEND": "postgres",
    "ALLOWED_ORIGINS": "https://autoflow.corretoresdabahia-com.workers.dev",
    "PUBLIC_BASE_URL": "https://autoflow.corretoresdabahia-com.workers.dev",
    "PORTAL_BASE_URL": "https://autoflow.corretoresdabahia-com.workers.dev",
    "PASSWORD_SCRYPT_LOG_N": "15"
  }
  // Segredos (wrangler secret put): APP_ENCRYPTION_KEY (32 bytes base64), IP_HASH_SALT, METRICS_TOKEN (>=24), TURNSTILE_SECRET, META_APP_SECRET, WA_VERIFY_TOKEN, SANDBOX_WEBHOOK_SECRET (se usar)
}
