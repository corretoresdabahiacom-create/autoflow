# AutoFlow — variáveis de ambiente (exemplo). NUNCA commitar valores reais.
# Valores abaixo servem apenas para banco LOCAL de desenvolvimento.

NODE_ENV=development

# Conexão da aplicação (role app_rw: sem BYPASSRLS, sem DDL)
DATABASE_URL=postgres://app_rw:app_rw_dev@127.0.0.1:5432/autoflow

# Conexão das migrations (role app_owner) — só para o processo de migração
MIGRATION_DATABASE_URL=postgres://app_owner:app_owner_dev@127.0.0.1:5432/autoflow

# Superusuário local, usado APENAS pelo comando db:bootstrap (criar roles/banco)
AF_SUPERUSER_URL=postgres://postgres:postgres@127.0.0.1:5432/postgres

# Chave AES-256 em base64 (32 bytes). Gerar com: openssl rand -base64 32
APP_ENCRYPTION_KEY=

# Sal para hash de IP em logs/auditoria. Gerar com: openssl rand -base64 24
IP_HASH_SALT=

# Origens permitidas para mutações (CSRF), separadas por vírgula
ALLOWED_ORIGINS=http://localhost:5173

# Custo do scrypt (log2 de N). Ver benchmark: pnpm bench:hash
PASSWORD_SCRYPT_LOG_N=15
