{
  "name": "@autoflow/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "dev": "tsx src/server.ts",
    "bench:hash": "tsx scripts/bench-hash.ts",
    "cf:dev": "wrangler dev --local --test-scheduled --var NODE_ENV:development --var ALLOWED_ORIGINS:http://localhost:8787",
    "cf:check": "wrangler deploy --dry-run --outdir .wrangler-dryrun",
    "cf:deploy": "wrangler deploy"
  },
  "dependencies": {
    "@autoflow/db": "workspace:*",
    "@autoflow/shared": "workspace:*",
    "@hono/node-server": "^2.1.6",
    "@noble/hashes": "^2.4.0",
    "hono": "^4.13.17",
    "pdf-lib": "1.17.1",
    "pg": "^8.23.1",
    "qrcode": "1.5.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "wrangler": "4.168.0"
  }
}
