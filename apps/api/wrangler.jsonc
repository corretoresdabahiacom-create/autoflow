// AUTOFLOW 2.0 — Cloudflare Workers (API + front estático no mesmo domínio). NÃO foi implantado: ver docs/CLOUDFLARE.md.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "autoflow",
  "main": "src/worker.ts",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  // Front (apps/web/dist). API em /api/*; SSR público, arquivos assinados e webhooks atendidos pelo Worker na raiz.
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/o/*", "/c/*", "/m/*", "/files/*", "/webhooks/*", "/robots.txt", "/sitemap*", "/health", "/ready", "/metrics"]
  },
  // Postgres externo (Neon/Supabase/RDS…) via Hyperdrive. Crie com: wrangler hyperdrive create autoflow-db --connection-string=...
  "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "SUBSTITUA_PELO_ID_DO_HYPERDRIVE", "localConnectionString": "postgres://app_rw:app_rw_dev@127.0.0.1:5432/autoflow_dev" }],
  // Bucket PRIVADO (sem domínio público). Crie com: wrangler r2 bucket create autoflow-files
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "autoflow-files" }],
  "triggers": { "crons": ["* * * * *", "*/5 * * * *", "0 * * * *"] },
  "observability": { "enabled": true },
  "vars": {
    "NODE_ENV": "production",
    "ALLOWED_ORIGINS": "https://SEU-DOMINIO",
    "PUBLIC_BASE_URL": "https://SEU-DOMINIO",
    "PORTAL_BASE_URL": "https://SEU-DOMINIO",
    "PASSWORD_SCRYPT_LOG_N": "15"
  }
  // Segredos (wrangler secret put): APP_ENCRYPTION_KEY (32 bytes base64), IP_HASH_SALT, METRICS_TOKEN (>=24), TURNSTILE_SECRET, META_APP_SECRET, WA_VERIFY_TOKEN, SANDBOX_WEBHOOK_SECRET (se usar)
}
